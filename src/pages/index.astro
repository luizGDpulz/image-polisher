---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Topbar -->
  <header
    class="h-16 px-6 flex items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-panel)] shrink-0"
  >
    <div class="flex items-center gap-3">
      <div
        class="w-9 h-9 rounded-lg bg-gradient-to-br from-purple-600 to-indigo-600 flex items-center justify-center text-white shadow-sm"
        aria-hidden="true"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-base font-semibold tracking-tight m-0">Image Polisher</h1>
        </div>
        <p id="file-name-badge" class="text-xs text-[var(--text-muted)] m-0">
          Cole um print com Ctrl+V ou arraste um arquivo
        </p>
      </div>
    </div>

    <!-- Métricas rápidas do canvas e ações -->
    <div class="flex items-center gap-2.5">
      <span
        id="dimensions-badge"
        class="hidden md:inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border-color)]"
      ></span>
      <span
        id="size-estimate-badge"
        class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20"
      ></span>

      <button
        type="button"
        id="btn-theme-toggle"
        class="p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer"
        title="Alternar tema Claro / Escuro"
        aria-label="Alternar tema Claro ou Escuro"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
      </button>

      <button
        type="button"
        id="btn-reset"
        class="px-3.5 py-2 rounded-lg text-sm font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer"
      >
        Resetar
      </button>

      <button
        type="button"
        id="btn-copy"
        disabled
        class="px-3.5 py-2 rounded-lg text-sm font-medium border border-[var(--border-color)] bg-[var(--bg-panel)] text-[var(--text-main)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center gap-1.5"
        title="Copiar imagem sombreada para a Área de Transferência (Ctrl+C)"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
          ></path>
        </svg>
        <span>Copiar</span>
      </button>

      <button
        type="button"
        id="btn-download"
        disabled
        class="px-4 py-2 rounded-lg text-sm font-semibold bg-[var(--color-brand)] text-white hover:opacity-95 shadow-sm disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        <span>Exportar <span id="download-format-label">PNG</span></span>
      </button>
    </div>
  </header>

  <!-- Main Workspace Layout -->
  <div class="flex flex-1 min-h-0 flex-col lg:flex-row lg:h-[calc(100vh-4rem)]">
    <!-- Sidebar de Controles -->
    <aside
      class="w-full lg:w-84 shrink-0 border-b lg:border-b-0 lg:border-r border-[var(--border-color)] bg-[var(--bg-panel)] overflow-y-auto p-5"
    >
      <form
        id="polisher-form"
        aria-label="Controles de Sombra e Exportação"
        class="flex flex-col gap-6"
      >
        <!-- Upload / Paste -->
        <div>
          <span
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2.5"
          >
            Imagem de Entrada
          </span>
          <label
            for="upload"
            id="dropzone-label"
            class="flex flex-col items-center justify-center gap-1.5 w-full p-4 rounded-xl border-2 border-dashed border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer text-center"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
              ></path>
            </svg>
            <span class="text-sm font-medium">Escolher ou arrastar imagem</span>
            <span class="text-xs opacity-80">Ou pressione <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-panel)] border border-[var(--border-color)] font-mono text-[11px]">Ctrl + V</kbd> na tela</span>
          </label>
          <input
            type="file"
            id="upload"
            name="upload"
            accept="image/*"
            class="visually-hidden"
          />
        </div>

        <!-- Presets Rápidos -->
        <fieldset class="border-0 p-0 m-0">
          <legend
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2.5"
          >
            Estilos Rápidos
          </legend>
          <div class="grid grid-cols-4 gap-1.5">
            <button
              type="button"
              data-preset="leve"
              aria-pressed="false"
              class="px-2.5 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] aria-pressed:border-[var(--color-brand)] aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] hover:border-[var(--border-strong)] transition cursor-pointer"
            >
              Leve
            </button>
            <button
              type="button"
              data-preset="medio"
              aria-pressed="true"
              class="px-2.5 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] aria-pressed:border-[var(--color-brand)] aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] hover:border-[var(--border-strong)] transition cursor-pointer"
            >
              Médio
            </button>
            <button
              type="button"
              data-preset="forte"
              aria-pressed="false"
              class="px-2.5 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] aria-pressed:border-[var(--color-brand)] aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] hover:border-[var(--border-strong)] transition cursor-pointer"
            >
              Forte
            </button>
            <button
              type="button"
              data-preset="flutuante"
              aria-pressed="false"
              class="px-2.5 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] aria-pressed:border-[var(--color-brand)] aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] hover:border-[var(--border-strong)] transition cursor-pointer"
            >
              Flutuante
            </button>
          </div>
        </fieldset>

        <!-- Ajustes de Sombra -->
        <fieldset class="border-0 p-0 m-0 flex flex-col gap-3.5">
          <legend
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1"
          >
            Ajustes de Sombra
          </legend>

          <!-- Deslocamento X -->
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="offsetX" class="text-xs font-medium">Deslocamento X (px)</label>
              <label for="numOffsetX" class="visually-hidden">Valor numérico de Deslocamento X</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="offsetX"
                name="offsetX"
                min="-80"
                max="80"
                value="0"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numOffsetX"
                name="numOffsetX"
                min="-80"
                max="80"
                value="0"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>

          <!-- Deslocamento Y -->
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="offsetY" class="text-xs font-medium">Deslocamento Y (px)</label>
              <label for="numOffsetY" class="visually-hidden">Valor numérico de Deslocamento Y</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="offsetY"
                name="offsetY"
                min="-80"
                max="80"
                value="8"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numOffsetY"
                name="numOffsetY"
                min="-80"
                max="80"
                value="8"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>

          <!-- Desfoque (Blur) -->
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="blur" class="text-xs font-medium">Desfoque / Blur (px)</label>
              <label for="numBlur" class="visually-hidden">Valor numérico de Desfoque</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="blur"
                name="blur"
                min="0"
                max="100"
                value="26"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numBlur"
                name="numBlur"
                min="0"
                max="100"
                value="26"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>

          <!-- Opacidade -->
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="opacity" class="text-xs font-medium">Opacidade</label>
              <label for="numOpacity" class="visually-hidden">Valor numérico de Opacidade</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="opacity"
                name="opacity"
                min="0"
                max="1"
                step="0.05"
                value="0.35"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numOpacity"
                name="numOpacity"
                min="0"
                max="1"
                step="0.05"
                value="0.35"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>

          <!-- Margem Extra (além do anti-corte automático) -->
          <div class="flex flex-col gap-1">
            <div class="flex justify-between items-center">
              <label for="extraPadding" class="text-xs font-medium">Margem Extra (px)</label>
              <span class="text-[11px] text-[var(--text-muted)]">Auto anti-corte ativo</span>
              <label for="numExtraPadding" class="visually-hidden">Valor numérico de Margem Extra</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="extraPadding"
                name="extraPadding"
                min="0"
                max="100"
                value="12"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numExtraPadding"
                name="numExtraPadding"
                min="0"
                max="100"
                value="12"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>
        </fieldset>

        <!-- Formato e Compressão -->
        <fieldset class="border-0 p-0 m-0 flex flex-col gap-3 pt-2 border-t border-[var(--border-color)]">
          <legend
            class="block text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-1"
          >
            Formato & Compressão
          </legend>

          <div class="grid grid-cols-2 gap-2">
            <div class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)]">
              <input
                type="radio"
                id="fmt-png"
                name="export-format"
                value="image/png"
                checked
              />
              <label for="fmt-png" class="text-xs font-medium cursor-pointer flex-1">
                PNG <span class="text-[10px] text-[var(--text-muted)] block">Original</span>
              </label>
            </div>

            <div class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)]">
              <input
                type="radio"
                id="fmt-webp"
                name="export-format"
                value="image/webp"
              />
              <label for="fmt-webp" class="text-xs font-medium cursor-pointer flex-1">
                WebP <span class="text-[10px] text-emerald-600 dark:text-emerald-400 block">Comprimido</span>
              </label>
            </div>

            <div class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)]">
              <input
                type="radio"
                id="fmt-avif"
                name="export-format"
                value="image/avif"
              />
              <label for="fmt-avif" class="text-xs font-medium cursor-pointer flex-1">
                AVIF <span class="text-[10px] text-purple-600 dark:text-purple-400 block">Ultra Leve</span>
              </label>
            </div>

            <div class="flex items-center gap-2 p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)]">
              <input
                type="radio"
                id="fmt-jpeg"
                name="export-format"
                value="image/jpeg"
              />
              <label for="fmt-jpeg" class="text-xs font-medium cursor-pointer flex-1">
                JPEG <span class="text-[10px] text-[var(--text-muted)] block">Fundo Branco</span>
              </label>
            </div>
          </div>

          <p id="format-hint" class="text-[11px] text-[var(--text-muted)] m-0 leading-relaxed">
            Sem perda de qualidade (Lossless) com fundo 100% transparente.
          </p>

          <!-- Controle de Qualidade (WebP / AVIF / JPEG) -->
          <div id="quality-control-wrapper" class="flex flex-col gap-1 transition-opacity opacity-50 pointer-events-none">
            <div class="flex justify-between items-center">
              <label for="quality" class="text-xs font-medium">Qualidade da Compressão (%)</label>
              <label for="numQuality" class="visually-hidden">Percentual de Qualidade</label>
            </div>
            <div class="flex items-center gap-2.5">
              <input
                type="range"
                id="quality"
                name="quality"
                min="10"
                max="100"
                step="2"
                value="88"
                class="flex-1 cursor-pointer"
              />
              <input
                type="number"
                id="numQuality"
                name="numQuality"
                min="10"
                max="100"
                value="88"
                class="w-16 px-2 py-1 rounded-md text-xs text-center border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-main)]"
              />
            </div>
          </div>
        </fieldset>
      </form>
    </aside>

    <!-- Área de Trabalho (Palco do Canvas) -->
    <main class="flex-1 relative flex flex-col items-center justify-center p-6 lg:p-10 overflow-hidden">
      <!-- Seletor de Fundo do Preview (apenas visualização, não afeta a transparência real) -->
      <div
        class="absolute top-4 right-4 z-10 flex items-center gap-1 p-1 rounded-lg bg-[var(--bg-panel)] border border-[var(--border-color)] shadow-sm"
        role="group"
        aria-label="Fundo de visualização do palco"
      >
        <span class="text-[11px] font-medium text-[var(--text-muted)] px-2">Preview:</span>
        <button
          type="button"
          data-stage-theme="checkerboard"
          aria-pressed="true"
          class="px-2.5 py-1 rounded-md text-xs font-medium aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition cursor-pointer"
        >
          Transparente
        </button>
        <button
          type="button"
          data-stage-theme="light"
          aria-pressed="false"
          class="px-2.5 py-1 rounded-md text-xs font-medium aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition cursor-pointer"
        >
          Claro
        </button>
        <button
          type="button"
          data-stage-theme="dark"
          aria-pressed="false"
          class="px-2.5 py-1 rounded-md text-xs font-medium aria-pressed:bg-purple-500/15 aria-pressed:text-[var(--color-brand)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition cursor-pointer"
        >
          Escuro
        </button>
      </div>

      <!-- Wrapper do Palco -->
      <div
        id="stage-wrapper"
        class="stage-checkerboard w-full h-full max-w-full max-h-full rounded-2xl border border-[var(--border-color)] shadow-sm flex items-center justify-center p-6 overflow-hidden transition-colors"
      >
        <!-- Estado Inicial Vazio -->
        <div
          id="empty-state"
          class="max-w-md text-center p-8 rounded-2xl bg-[var(--bg-panel)]/95 backdrop-blur border border-[var(--border-color)] shadow-lg flex flex-col items-center gap-4"
        >
          <div
            class="w-12 h-12 rounded-2xl bg-purple-500/10 text-[var(--color-brand)] flex items-center justify-center"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-semibold m-0 mb-1">Pronto para polir seu print</h2>
            <p class="text-xs text-[var(--text-muted)] m-0 leading-relaxed">
              Tire um print (<kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono">Win + Shift + S</kbd>) e pressione <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono font-semibold text-[var(--color-brand)]">Ctrl + V</kbd> aqui mesmo, ou arraste um arquivo de imagem.
            </p>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <button
              type="button"
              id="btn-sample"
              class="px-3.5 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-main)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer"
            >
              Testar com Print de Exemplo
            </button>
          </div>
        </div>

        <!-- Container do Canvas (visível assim que uma imagem é carregada) -->
        <div
          id="canvas-container"
          class="hidden w-full h-full flex items-center justify-center overflow-hidden"
        >
          <canvas
            id="canvas"
            class="max-w-full max-h-full object-contain block rounded"
          ></canvas>
        </div>
      </div>

      <!-- Toast de Feedback Acessível -->
      <div
        id="status-toast"
        role="status"
        aria-live="polite"
        class="fixed bottom-5 right-5 z-50 px-4 py-2.5 rounded-xl bg-gray-900 text-white text-xs font-medium shadow-lg transition-all duration-200 opacity-0 translate-y-2 pointer-events-none"
      ></div>
    </main>
  </div>

  <script>
    import { initImagePolisher } from '../scripts/polisher-client';
    document.getElementById('polisher-form')?.addEventListener('submit', (e) => e.preventDefault());
    initImagePolisher();
  </script>
</Layout>
