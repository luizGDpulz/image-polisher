                          class="w-[13px] h-[13px] text-[var(--text-muted)] group-open:text-[var(--color-brand)] transition-colors"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <circle cx="6" cy="6" r="3"></circle>
                          <path d="M8.12 8.12 12 12"></path>
                          <path d="M20 4 8.12 15.88"></path>
                          <circle cx="6" cy="18" r="3"></circle>
                          <path d="M14.8 14.8 20 20"></path>
                        </svg>
                        <span
                          class="text-xs font-medium text-[var(--text-secondary)] group-open:text-[var(--text-main)]"
                        >
                          Recorte do trecho
                        </span>
                      </span>
                      <!-- Lucide: chevron-down -->
                      <svg
                        class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-200 group-open:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </summary>

                    <div class="px-4 pb-4 pt-2.5 flex flex-col gap-3 bg-[var(--bg-subtle)]/35">
                      <!-- Início (s) -->
                      <div class="flex flex-col gap-1">
                        <div class="flex items-center justify-between gap-2">
                          <label
                            for="videoStart"
                            class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                          >
                            Início (s)
                          </label>
                          <label for="numVideoStart" class="visually-hidden">Instante inicial do recorte em segundos</label>
                          <div
                            class="inline-flex items-center rounded-md border border-[var(--border-color)] bg-[var(--bg-panel)] p-0.5"
                          >
                            <button
                              type="button"
                              data-step-target="numVideoStart"
                              data-step-dir="-1"
                              class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                              aria-label="Diminuir Início"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                              </svg>
                            </button>
                            <input
                              type="number"
                              id="numVideoStart"
                              name="numVideoStart"
                              min="0"
                              max="10"
                              step="0.1"
                              value="0"
                              class="w-11 text-center font-mono text-[11px] text-[var(--text-main)] bg-transparent border-0"
                            />
                            <button
                              type="button"
                              data-step-target="numVideoStart"
                              data-step-dir="1"
                              class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                              aria-label="Aumentar Início"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="M12 5v14"></path>
                              </svg>
                            </button>
                          </div>
                        </div>
                        <input type="range" id="videoStart" name="videoStart" min="0" max="10" step="0.1" value="0" />
                      </div>

                      <!-- Fim (s) -->
                      <div class="flex flex-col gap-1">
                        <div class="flex items-center justify-between gap-2">
                          <label
                            for="videoEnd"
                            class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                          >
                            Fim (s)
                          </label>
                          <label for="numVideoEnd" class="visually-hidden">Instante final do recorte em segundos</label>
                          <div
                            class="inline-flex items-center rounded-md border border-[var(--border-color)] bg-[var(--bg-panel)] p-0.5"
                          >
                            <button
                              type="button"
                              data-step-target="numVideoEnd"
                              data-step-dir="-1"
                              class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                              aria-label="Diminuir Fim"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                              </svg>
                            </button>
                            <input
                              type="number"
                              id="numVideoEnd"
                              name="numVideoEnd"
                              min="0"
                              max="10"
                              step="0.1"
                              value="10"
                              class="w-11 text-center font-mono text-[11px] text-[var(--text-main)] bg-transparent border-0"
                            />
                            <button
                              type="button"
                              data-step-target="numVideoEnd"
                              data-step-dir="1"
                              class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                              aria-label="Aumentar Fim"
                            >
                              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14"></path>
                                <path d="M12 5v14"></path>
                              </svg>
                            </button>
                          </div>
                        </div>
                        <input type="range" id="videoEnd" name="videoEnd" min="0" max="10" step="0.1" value="10" />
                      </div>

                      <p
                        id="video-trim-summary"
                        class="text-[11px] font-mono text-[var(--text-muted)] m-0"
                      >
                        Trecho: 0.0s – 0.0s (0 frames)
                      </p>

                      <p
                        id="video-frames-warning"
                        hidden
                        class="polisher-warning-box text-[11px] px-2.5 py-1.5 rounded-lg m-0 leading-relaxed"
                      ></p>
                    </div>
                  </details>
                </section>
              </div>
            </div>
          </form>
        </div>
      </aside>

      <!-- Ilha 3: Palco Principal -->
      <main class="flex-1 min-w-0 min-h-0 relative flex flex-col gap-2.5 overflow-hidden">
        <!-- Wrapper do Palco -->
        <div
          id="stage-wrapper"
          class="stage-checkerboard relative flex-1 w-full min-w-0 min-h-[360px] lg:h-full rounded-xl border border-[var(--border-color)] shadow-[0_2px_10px_rgba(0,0,0,0.03)] overflow-hidden select-none transition-colors"
        >
          <!-- Ilha Flutuante: Fundo do Preview -->
          <div
            id="stage-theme-toolbar"
            class="absolute top-3 right-3 z-20 flex items-center gap-1 p-1 rounded-lg bg-[var(--bg-panel)]/95 backdrop-blur border border-[var(--border-color)] shadow-sm"
            role="group"
            aria-label="Fundo de visualização do palco"
          >
            <button
              type="button"
              data-stage-theme="checkerboard"
              aria-pressed="true"
              class="px-2 py-1 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:text-[var(--color-brand)] transition cursor-pointer flex items-center gap-1"
            >
              <!-- Lucide: grid-2x2 -->
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M3 12h18"></path>
                <path d="M12 3v18"></path>
              </svg>
              <span>Grade</span>
            </button>

            <button
              type="button"
              data-stage-theme="light"
              aria-pressed="false"
              class="px-2 py-1 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:text-[var(--color-brand)] transition cursor-pointer flex items-center gap-1"
            >
              <!-- Lucide: sun -->
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <span>Claro</span>
            </button>

            <button
              type="button"
              data-stage-theme="dark"
              aria-pressed="false"
              class="px-2 py-1 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:text-[var(--color-brand)] transition cursor-pointer flex items-center gap-1"
            >
              <!-- Lucide: moon -->
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
              <span>Escuro</span>
            </button>
          </div>

          <!-- Ilha Flutuante: Controles de Zoom -->
          <div
            id="zoom-toolbar"
            class="hidden absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1 p-1 rounded-xl bg-[var(--bg-panel)]/95 backdrop-blur border border-[var(--border-color)] shadow-md"
            role="group"
            aria-label="Controles de zoom e ajuste do palco"
          >
            <button
              type="button"
              id="btn-zoom-out"
              class="w-7 h-7 flex items-center justify-center rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
              title="Diminuir Zoom (Roda do mouse para baixo)"
              aria-label="Diminuir Zoom"
            >
              <!-- Lucide: minus -->
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
              </svg>
            </button>

            <button
              type="button"
              id="btn-zoom-100"
              class="min-w-[50px] px-2 py-1 rounded-lg text-[11px] font-mono font-medium text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer text-center"
              title="Clique para ver em 100% (1:1 pixels reais)"
            >
              100%
            </button>

            <button
              type="button"
              id="btn-zoom-in"
              class="w-7 h-7 flex items-center justify-center rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
              title="Aumentar Zoom (Roda do mouse para cima)"
              aria-label="Aumentar Zoom"
            >
              <!-- Lucide: plus -->
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14"></path>
                <path d="M12 5v14"></path>
              </svg>
            </button>

            <div class="w-px h-4 bg-[var(--border-color)] mx-0.5" aria-hidden="true"></div>

            <button
              type="button"
              id="btn-zoom-fit"
              aria-pressed="true"
              class="px-2.5 py-1 rounded-lg text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:text-[var(--color-brand)] transition cursor-pointer inline-flex items-center gap-1"
              title="Auto-redimensionar e centralizar no palco (Duplo clique no palco)"
            >
              <!-- Lucide: maximize-2 -->
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="15 3 21 3 21 9"></polyline>
                <polyline points="9 21 3 21 3 15"></polyline>
                <line x1="21" x2="14" y1="3" y2="10"></line>
                <line x1="3" x2="10" y1="21" y2="14"></line>
              </svg>
              <span>Ajustar</span>
            </button>

            <div id="playback-controls-group" hidden class="flex items-center gap-1">
              <div class="w-px h-4 bg-[var(--border-color)] mx-0.5" aria-hidden="true"></div>

              <button
                type="button"
                id="btn-anim-play-pause"
                class="w-7 h-7 flex items-center justify-center rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                title="Pausar ou retomar animação"
                aria-label="Pausar animação"
              >
                <!-- Lucide: pause -->
                <svg
                  id="icon-anim-pause"
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="4" height="16" x="6" y="4"></rect>
                  <rect width="4" height="16" x="14" y="4"></rect>
                </svg>
                <!-- Lucide: play -->
                <svg
                  id="icon-anim-play"
                  class="w-3.5 h-3.5 hidden"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polygon points="6 3 20 12 6 21 6 3"></polygon>
                </svg>
              </button>

              <span
                id="anim-playback-label"
                class="px-1.5 text-[11px] font-mono text-[var(--text-muted)] whitespace-nowrap"
              >
                0.0s
              </span>
            </div>
          </div>

          <!-- Estado Inicial Vazio -->
          <div id="empty-state" class="absolute inset-0 flex items-center justify-center p-6">
            <div
              class="max-w-sm w-full text-center p-7 rounded-xl bg-[var(--bg-panel)] border border-[var(--border-color)] shadow-[0_4px_16px_rgba(0,0,0,0.06)] flex flex-col items-center gap-3.5"
            >
              <div
                class="w-10 h-10 rounded-lg bg-[var(--brand-subtle)] text-[var(--color-brand)] flex items-center justify-center"
                aria-hidden="true"
              >
                <!-- Lucide: image -->
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                  <circle cx="9" cy="9" r="2"></circle>
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold m-0 mb-1 text-[var(--text-main)]">
                  Pronto para polir imagens e vídeos
                </h2>
                <p class="text-xs text-[var(--text-muted)] m-0 leading-relaxed">
                  Cole com <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-[11px] text-[var(--text-main)]">Ctrl + V</kbd> ou arraste imagens, GIFs ou vídeos (MP4, WebM, MOV) aqui.
                </p>
              </div>
              <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
                <label
                  for="upload"
                  class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white transition cursor-pointer"
                >
                  Selecionar arquivos
                </label>
                <button
                  type="button"
                  id="btn-sample"
                  class="px-3.5 py-1.5 rounded-lg text-xs font-medium border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-muted)] transition cursor-pointer"
                >
                  Print de Exemplo
                </button>
              </div>
            </div>
          </div>

          <!-- Container do Canvas -->
          <div
            id="canvas-container"
            class="hidden absolute inset-0 overflow-hidden cursor-grab active:cursor-grabbing touch-none"
          >
            <div
              id="canvas-transform"
              class="w-full h-full flex items-center justify-center pointer-events-none origin-center will-change-transform"
            >
              <canvas id="canvas" class="block shrink-0 max-w-none max-h-none"></canvas>
            </div>
          </div>
        </div>

        <!-- Card Flutuante de Progresso de Exportação -->
        <div
          id="export-progress-card"
          hidden
          role="region"
          aria-live="polite"
          aria-label="Progresso da exportação"
          class="fixed bottom-[4.75rem] left-1/2 -translate-x-1/2 z-40 w-[min(22rem,calc(100vw-2rem))] rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)]/95 backdrop-blur-md shadow-[0_6px_24px_rgba(0,0,0,0.1)] p-3 flex flex-col gap-2"
        >
          <div class="flex items-center justify-between gap-2">
            <span
              id="export-progress-label"
              class="text-xs font-medium text-[var(--text-main)] truncate"
            >
              Exportando...
            </span>
            <button
              type="button"
              id="btn-export-cancel"
              class="px-2 py-0.5 rounded-md text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-red-600 hover:border-red-500/40 transition cursor-pointer shrink-0"
            >
              Cancelar
            </button>
          </div>
          <progress
            id="export-progress"
            max="100"
            value="0"
            aria-labelledby="export-progress-label"
            class="polisher-progress w-full h-1.5"
          ></progress>
        </div>

        <!-- Toast de Feedback Acessível -->
        <div
          id="status-toast"
          role="status"
          aria-live="polite"
          class="fixed bottom-[4.75rem] right-5 z-50 px-3.5 py-2 rounded-lg bg-[#1c1c1a] text-white border border-white/10 text-xs font-medium shadow-lg transition-all duration-200 opacity-0 translate-y-2 pointer-events-none"
        ></div>
      </main>
    </div>

    <!-- Ilha 4: Rodapé Flutuante (Status + Fila de Múltiplos Arquivos) -->
    <footer
      id="floating-footer"
      aria-label="Rodapé de arquivos e fila em lote"
      class="floating-footer sticky bottom-3 lg:static z-30 shrink-0 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)]/95 lg:bg-[var(--bg-panel)] backdrop-blur-md shadow-[0_6px_24px_rgba(0,0,0,0.06)] lg:shadow-[0_2px_10px_rgba(0,0,0,0.03)] px-3.5 py-2 flex items-center justify-between gap-3"
    >
      <!-- Estado compacto (0 ou 1 arquivo) -->
      <div
        id="footer-single-info"
        class="footer-slot flex-1 min-w-0 items-center gap-2 text-xs text-[var(--text-muted)]"
      >
        <!-- Lucide: images -->
        <svg
          class="w-3.5 h-3.5 shrink-0 text-[var(--text-muted)]"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 22H4a2 2 0 0 1-2-2V6"></path>
          <path d="m22 13-1.296-1.296a2.41 2.41 0 0 0-3.408 0L11 18"></path>
          <circle cx="12" cy="8" r="2"></circle>
          <rect width="16" height="16" x="6" y="2" rx="2"></rect>
        </svg>
        <span id="footer-status-text" class="truncate">
          Abra ou arraste imagens, GIFs ou vídeos para editar e exportar em lote
        </span>
      </div>

      <!-- Fila de Múltiplos Arquivos (exibida quando há 2+ arquivos) -->
      <div
        id="batch-queue-bar"
        hidden
        class="footer-slot flex-1 min-w-0 items-center gap-2.5"
        aria-label="Fila de imagens em lote"
      >
        <span
          id="batch-count-label"
          class="text-[11px] font-semibold text-[var(--text-secondary)] bg-[var(--bg-subtle)] border border-[var(--border-color)] px-2.5 py-1 rounded-lg shrink-0"
        >
          Lote (0)
        </span>
        <div
          id="batch-queue-list"
          role="list"
          aria-label="Arquivos abertos"
          class="batch-scroller flex-1 min-w-0 flex items-center gap-2 overflow-x-auto py-0.5"
        ></div>
      </div>

      <!-- Ações do Rodapé -->
      <div class="flex items-center gap-1.5 shrink-0 pl-2.5 border-l border-[var(--border-color)]">
        <button
          type="button"
          id="btn-batch-add"
          class="h-7 px-2.5 rounded-lg text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer inline-flex items-center gap-1"
          title="Adicionar arquivos à fila"
        >
          <!-- Lucide: plus -->
          <svg
            class="w-3 h-3 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="M12 5v14"></path>
          </svg>
          <span>Adicionar</span>
        </button>
        <button
          type="button"
          id="btn-batch-clear"
          hidden
          class="h-7 px-2.5 rounded-lg text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-red-600 hover:border-red-500/40 transition cursor-pointer"
          title="Limpar todas as imagens"
        >
          Limpar
        </button>
      </div>
    </footer>
  </div>

  <script>
    import { initImagePolisher } from '../scripts/polisher-client';
    document.getElementById('polisher-form')?.addEventListener('submit', (e) => e.preventDefault());
    initImagePolisher();
  </script>
</Layout>
