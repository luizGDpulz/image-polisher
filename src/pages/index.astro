---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div
    class="flex flex-1 min-h-0 flex-col lg:h-dvh lg:overflow-hidden bg-[var(--bg-app)] p-3 lg:p-4 gap-3"
  >
    <!-- Ilha 1: Header Flutuante -->
    <header
      class="h-13 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] shadow-[0_2px_10px_rgba(0,0,0,0.03)] flex items-center justify-between gap-3 shrink-0"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <div
          class="w-8 h-8 rounded-lg bg-[var(--brand-subtle)] border border-[var(--brand-border)] text-[var(--color-brand)] flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <!-- Lucide: layers -->
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"
            ></path>
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
          </svg>
        </div>

        <h1 class="text-sm font-semibold tracking-tight text-[var(--text-main)] m-0 whitespace-nowrap">
          Image Polisher
        </h1>

        <span class="hidden sm:block w-px h-4 bg-[var(--border-color)] shrink-0" aria-hidden="true"></span>

        <span
          id="file-name-badge"
          class="hidden sm:inline text-xs text-[var(--text-muted)] truncate max-w-[180px] lg:max-w-[260px]"
        >
          Cole Ctrl+V ou arraste imagens
        </span>

        <span
          id="dimensions-badge"
          class="hidden items-center px-2 py-0.5 rounded-md text-[11px] font-mono bg-[var(--bg-subtle)] text-[var(--text-muted)] border border-[var(--border-color)] shrink-0"
        ></span>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <label
          for="upload"
          id="dropzone-label"
          class="px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer inline-flex items-center gap-1.5"
          title="Escolher ou arrastar imagens"
        >
          <!-- Lucide: upload -->
          <svg
            class="w-3.5 h-3.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" x2="12" y1="3" y2="15"></line>
          </svg>
          <span class="hidden sm:inline">Abrir imagens</span>
        </label>

        <input
          type="file"
          id="upload"
          name="upload"
          accept="image/*"
          multiple
          class="visually-hidden"
        />
        <input
          type="file"
          id="upload-append"
          accept="image/*"
          multiple
          class="visually-hidden"
        />

        <button
          type="button"
          id="btn-theme-toggle"
          class="w-8 h-8 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer flex items-center justify-center"
          title="Alternar tema Claro / Escuro"
          aria-label="Alternar tema Claro ou Escuro"
        >
          <!-- Lucide: sun-moon -->
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"></path>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.9 4.9 1.4 1.4"></path>
            <path d="m17.7 17.7 1.4 1.4"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.3 17.7-1.4 1.4"></path>
            <path d="m19.1 4.9-1.4 1.4"></path>
          </svg>
        </button>

        <button
          type="button"
          id="btn-reset"
          class="w-8 h-8 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer flex items-center justify-center"
          title="Resetar ajustes e enquadramento"
          aria-label="Resetar ajustes e enquadramento"
        >
          <!-- Lucide: rotate-ccw -->
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
            <path d="M3 3v5h5"></path>
          </svg>
        </button>

        <span class="w-px h-4 bg-[var(--border-color)] mx-0.5 shrink-0" aria-hidden="true"></span>

        <button
          type="button"
          id="btn-copy"
          disabled
          class="px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--border-strong)] bg-[var(--bg-panel)] text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-main)] disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center gap-1.5"
          title="Copiar imagem sombreada para a Área de Transferência (Ctrl+C)"
        >
          <!-- Lucide: copy -->
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span class="hidden sm:inline">Copiar</span>
        </button>

        <div class="inline-flex items-center rounded-lg shadow-xs">
          <button
            type="button"
            id="btn-download"
            disabled
            class="px-3 py-1.5 rounded-l-lg text-xs font-semibold bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center gap-1.5"
          >
            <!-- Lucide: check -->
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span>
              <span id="download-action-label">Exportar</span>
              <span id="download-format-label">PNG</span>
            </span>
          </button>

          <button
            type="button"
            id="btn-export-options"
            popovertarget="export-options-popover"
            class="px-1.5 py-1.5 rounded-r-lg border-l border-white/20 bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white transition cursor-pointer inline-flex items-center justify-center"
            title="Opções de formato e compressão"
            aria-label="Opções de formato e compressão"
          >
            <!-- Lucide: chevron-down -->
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
        </div>

        <!-- Popover de Opções de Saída (ancorado ao botão de exportação) -->
        <div
          id="export-options-popover"
          popover="auto"
          class="w-72 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] text-[var(--text-main)] shadow-[0_10px_30px_rgba(0,0,0,0.12)] p-3.5"
        >
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between gap-2">
              <span
                class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
              >
                Formato de Saída
              </span>
              <span
                id="size-estimate-badge"
                class="text-[11px] font-mono font-medium text-[var(--color-brand)]"
              >
                —
              </span>
            </div>

            <div class="grid grid-cols-4 gap-1.5">
              <label
                for="fmt-png"
                class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
              >
                <input
                  type="radio"
                  id="fmt-png"
                  name="export-format"
                  value="image/png"
                  checked
                  class="visually-hidden"
                />
                <span>PNG</span>
              </label>

              <label
                for="fmt-webp"
                class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
              >
                <input
                  type="radio"
                  id="fmt-webp"
                  name="export-format"
                  value="image/webp"
                  class="visually-hidden"
                />
                <span>WebP</span>
              </label>

              <label
                for="fmt-avif"
                class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
              >
                <input
                  type="radio"
                  id="fmt-avif"
                  name="export-format"
                  value="image/avif"
                  class="visually-hidden"
                />
                <span>AVIF</span>
              </label>

              <label
                for="fmt-jpeg"
                class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
              >
                <input
                  type="radio"
                  id="fmt-jpeg"
                  name="export-format"
                  value="image/jpeg"
                  class="visually-hidden"
                />
                <span>JPEG</span>
              </label>
            </div>

            <p id="format-hint" class="text-[11px] text-[var(--text-muted)] m-0 leading-relaxed">
              Sem perda de qualidade (Lossless) com fundo 100% transparente.
            </p>

            <p
              id="gif-format-note"
              class="hidden text-[11px] text-[var(--color-brand)] bg-[var(--brand-subtle)] px-2.5 py-1.5 rounded-lg m-0 leading-relaxed"
            >
              GIFs animados são exportados em <strong>.gif</strong> preservando todos os frames.
            </p>

            <!-- Qualidade (exibida apenas em formatos comprimidos WebP / AVIF / JPEG) -->
            <div
              id="quality-control-wrapper"
              class="hidden flex flex-col gap-1 pt-2 border-t border-[var(--border-color)]"
            >
              <div class="flex items-center justify-between gap-2">
                <label
                  for="quality"
                  class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                >
                  Qualidade (%)
                </label>
                <label for="numQuality" class="visually-hidden">Percentual de Qualidade</label>
                <div
                  class="inline-flex items-center rounded-md border border-[var(--border-color)] bg-[var(--bg-panel)] p-0.5"
                >
                  <button
                    type="button"
                    data-step-target="numQuality"
                    data-step-dir="-1"
                    class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                    aria-label="Diminuir Qualidade"
                  >
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14"></path>
                    </svg>
                  </button>
                  <input
                    type="number"
                    id="numQuality"
                    name="numQuality"
                    min="10"
                    max="100"
                    step="2"
                    value="88"
                    class="w-10 text-center font-mono text-[11px] text-[var(--text-main)] bg-transparent border-0"
                  />
                  <button
                    type="button"
                    data-step-target="numQuality"
                    data-step-dir="1"
                    class="w-5 h-5 rounded flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
                    aria-label="Aumentar Qualidade"
                  >
                    <svg
                      class="w-3 h-3"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14"></path>
                      <path d="M12 5v14"></path>
                    </svg>
                  </button>
                </div>
              </div>
              <input
                type="range"
                id="quality"
                name="quality"
                min="10"
                max="100"
                step="2"
                value="88"
              />
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Área Inferior de Trabalho -->
    <div class="flex-1 min-h-0 flex flex-col lg:flex-row gap-3 overflow-hidden">
      <!-- Ilha 2A: Rail de Ferramentas (Menu de Opções com Botões Ícones) -->
      <nav
        aria-label="Menu de ferramentas"
        class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] shadow-[0_2px_10px_rgba(0,0,0,0.03)] p-1.5 flex lg:flex-col items-center gap-1.5 shrink-0 self-start"
      >
        <button
          type="button"
          id="btn-tool-shadow"
          aria-pressed="true"
          aria-controls="tool-properties-panel"
          class="w-11 h-11 rounded-lg border border-transparent flex flex-col items-center justify-center gap-1 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:text-[var(--color-brand)] aria-pressed:border-[var(--brand-border)] transition cursor-pointer"
          title="Propriedades de Sombra e Exportação"
        >
          <!-- Lucide: eclipse -->
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a7 7 0 1 0 10 10"></path>
          </svg>
          <span class="text-[9px] font-semibold leading-none">Sombra</span>
        </button>
      </nav>

      <!-- Coluna de Propriedades da Opção Ativa -->
      <aside
        id="tool-properties-panel"
        class="w-full lg:w-[296px] shrink-0 flex flex-col gap-3 max-h-[52vh] lg:max-h-full overflow-y-auto pr-0.5"
      >
        <form
          id="polisher-form"
          aria-label="Controles de Sombra e Exportação"
          class="flex flex-col gap-3"
        >
          <!-- Ilha 2B: Propriedades da Sombra -->
          <section
            aria-labelledby="shadow-card-title"
            class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] shadow-[0_2px_10px_rgba(0,0,0,0.03)] overflow-hidden"
          >
            <div
              class="px-4 py-3 border-b border-[var(--border-color)] flex items-center justify-between gap-2"
            >
              <h2 id="shadow-card-title" class="text-xs font-semibold text-[var(--text-main)] m-0">
                Sombra
              </h2>
              <span
                id="active-preset-label"
                class="text-[11px] font-medium text-[var(--color-brand)] bg-[var(--brand-subtle)] px-2 py-0.5 rounded-md"
              >
                Médio
              </span>
            </div>

            <!-- Estilos Predefinidos -->
            <div class="p-3.5">
              <fieldset class="border-0 p-0 m-0">
                <legend
                  class="block text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2"
                >
                  Estilos Predefinidos
                </legend>
                <div class="grid grid-cols-4 gap-1.5">
                  <button
                    type="button"
                    data-preset="leve"
                    aria-pressed="false"
                    class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                    title="Sombra leve e discreta"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <rect x="4" y="4" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
                      <path d="M6 17h10M16 6v10" stroke="currentColor" stroke-width="1.2" stroke-dasharray="1.5 2" opacity="0.7" />
                    </svg>
                    <span class="text-[10px] font-medium leading-none">Leve</span>
                  </button>

                  <button
                    type="button"
                    data-preset="medio"
                    aria-pressed="true"
                    class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                    title="Sombra equilibrada para prints"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <rect x="3.5" y="3" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
                      <rect x="6.5" y="6" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.8" />
                    </svg>
                    <span class="text-[10px] font-medium leading-none">Médio</span>
                  </button>

                  <button
                    type="button"
                    data-preset="forte"
                    aria-pressed="false"
                    class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                    title="Sombra marcada com maior contraste"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <rect x="3" y="2.5" width="10.5" height="10.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                      <rect x="6.5" y="6" width="10.5" height="10.5" rx="2" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.2" />
                    </svg>
                    <span class="text-[10px] font-medium leading-none">Forte</span>
                  </button>

                  <button
                    type="button"
                    data-preset="flutuante"
                    aria-pressed="false"
                    class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                    title="Elevação alta com sombra suave abaixo"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <rect x="4.5" y="2.5" width="11" height="9.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                      <ellipse cx="10" cy="16.5" rx="5.5" ry="1.5" fill="currentColor" fill-opacity="0.35" />
                    </svg>
                    <span class="text-[10px] font-medium leading-none">Flutuar</span>
                  </button>
                </div>
              </fieldset>
            </div>

            <!-- Gaveta de Personalização (fechada por padrão para não poluir o visual) -->
            <details
              id="custom-shadow-details"
              class="group border-t border-[var(--border-color)]"
            >
              <summary
                class="px-4 py-2.5 flex items-center justify-between cursor-pointer select-none hover:bg-[var(--bg-subtle)]/70 transition"
              >
                <span class="flex items-center gap-2">
                  <!-- Lucide: sliders-horizontal -->
                  <svg
                    class="w-[13px] h-[13px] text-[var(--text-muted)] group-open:text-[var(--color-brand)] transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <line x1="21" x2="14" y1="4" y2="4"></line>
                    <line x1="10" x2="3" y1="4" y2="4"></line>
                    <line x1="21" x2="12" y1="12" y2="12"></line>
                    <line x1="8" x2="3" y1="12" y2="12"></line>
                    <line x1="21" x2="16" y1="20" y2="20"></line>
                    <line x1="12" x2="3" y1="20" y2="20"></line>
                    <line x1="14" x2="14" y1="2" y2="6"></line>
                    <line x1="8" x2="8" y1="10" y2="14"></line>
                    <line x1="16" x2="16" y1="18" y2="22"></line>
                  </svg>
                  <span
                    class="text-xs font-medium text-[var(--text-secondary)] group-open:text-[var(--text-main)]"
                  >
                    Personalizar
                  </span>
                </span>
                <!-- Lucide: chevron-down -->
                <svg
                  class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-200 group-open:rotate-180"
                  fill="none"
