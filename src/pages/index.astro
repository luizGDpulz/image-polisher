---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div
    class="flex flex-1 min-h-0 flex-col lg:flex-row lg:h-dvh lg:overflow-hidden bg-[var(--bg-app)] p-3 lg:p-4 gap-3 lg:gap-4"
  >
    <!-- Painel Inspetor Lateral Sóbrio -->
    <aside
      class="w-full lg:w-[320px] shrink-0 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] shadow-[0_4px_16px_rgba(0,0,0,0.04)] flex flex-col max-h-[60vh] lg:max-h-full overflow-hidden"
    >
      <!-- Cabeçalho Discreto do Inspetor -->
      <header
        class="h-11 px-4 flex items-center justify-between border-b border-[var(--border-color)] shrink-0"
      >
        <span
          class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[var(--text-muted)]"
        >
          Image Polisher
        </span>

        <div class="flex items-center gap-1">
          <label
            for="upload"
            class="w-7 h-7 rounded-md flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
            title="Abrir imagens"
            aria-label="Abrir imagens"
          >
            <!-- Lucide: image-plus -->
            <svg
              class="w-[15px] h-[15px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M16 5h6"></path>
              <path d="M19 2v6"></path>
              <path d="M21 11.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7.5"></path>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
              <circle cx="9" cy="9" r="2"></circle>
            </svg>
          </label>

          <button
            type="button"
            id="btn-reset"
            class="w-7 h-7 rounded-md flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
            title="Resetar ajustes e enquadramento"
            aria-label="Resetar ajustes e enquadramento"
          >
            <!-- Lucide: rotate-ccw -->
            <svg
              class="w-[15px] h-[15px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
              <path d="M3 3v5h5"></path>
            </svg>
          </button>

          <button
            type="button"
            id="btn-theme-toggle"
            class="w-7 h-7 rounded-md flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-subtle)] transition cursor-pointer"
            title="Alternar tema Claro / Escuro"
            aria-label="Alternar tema Claro ou Escuro"
          >
            <!-- Lucide: sun-moon -->
            <svg
              class="w-[15px] h-[15px]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 8a2.83 2.83 0 0 0 4 4 4 4 0 1 1-4-4"></path>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.9 4.9 1.4 1.4"></path>
              <path d="m17.7 17.7 1.4 1.4"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.3 17.7-1.4 1.4"></path>
              <path d="m19.1 4.9-1.4 1.4"></path>
            </svg>
          </button>
        </div>
      </header>

      <!-- Corpo Rolável do Inspetor -->
      <form
        id="polisher-form"
        aria-label="Controles de Sombra e Exportação"
        class="flex-1 min-h-0 overflow-y-auto divide-y divide-[var(--border-color)]"
      >
        <!-- Entrada de Imagens Compacta -->
        <div class="p-3.5">
          <label
            for="upload"
            id="dropzone-label"
            class="flex items-center justify-between gap-2 w-full px-3 py-2.5 rounded-lg border border-dashed border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer"
          >
            <span class="flex items-center gap-2 min-w-0">
              <!-- Lucide: upload -->
              <svg
                class="w-3.5 h-3.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" x2="12" y1="3" y2="15"></line>
              </svg>
              <span class="text-xs font-medium truncate">Escolher ou soltar imagens</span>
            </span>
            <kbd
              class="shrink-0 px-1.5 py-0.5 rounded bg-[var(--bg-panel)] border border-[var(--border-color)] font-mono text-[10px] text-[var(--text-muted)]"
            >
              Ctrl+V
            </kbd>
          </label>
          <input
            type="file"
            id="upload"
            name="upload"
            accept="image/*"
            multiple
            class="visually-hidden"
          />
          <input
            type="file"
            id="upload-append"
            accept="image/*"
            multiple
            class="visually-hidden"
          />
        </div>

        <!-- Seção 1: Sombra & Elevação -->
        <details open class="group">
          <summary
            class="px-4 py-3 flex items-center justify-between cursor-pointer select-none hover:bg-[var(--bg-subtle)]/70 transition"
          >
            <span class="flex items-center gap-2">
              <span
                class="w-6 h-6 rounded-md bg-[var(--brand-subtle)] text-[var(--color-brand)] flex items-center justify-center shrink-0"
                aria-hidden="true"
              >
                <!-- Lucide: layers -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"
                  ></path>
                  <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
                  <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
                </svg>
              </span>
              <span class="text-xs font-semibold text-[var(--text-main)]">Sombra & Elevação</span>
            </span>
            <!-- Lucide: chevron-up -->
            <svg
              class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-200 rotate-180 group-open:rotate-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
          </summary>

          <div class="px-4 pb-4 pt-1 flex flex-col gap-3.5">
            <!-- Presets Visuais -->
            <fieldset class="border-0 p-0 m-0">
              <legend
                class="block text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2"
              >
                Estilos de Sombra
              </legend>
              <div class="grid grid-cols-4 gap-1.5">
                <button
                  type="button"
                  data-preset="leve"
                  aria-pressed="false"
                  class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                  title="Sombra leve e discreta"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <rect x="4" y="4" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <path d="M6 17h10M16 6v10" stroke="currentColor" stroke-width="1.2" stroke-dasharray="1.5 2" opacity="0.7" />
                  </svg>
                  <span class="text-[10px] font-medium leading-none">Leve</span>
                </button>

                <button
                  type="button"
                  data-preset="medio"
                  aria-pressed="true"
                  class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                  title="Sombra equilibrada para prints"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <rect x="3.5" y="3" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <rect x="6.5" y="6" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" opacity="0.8" />
                  </svg>
                  <span class="text-[10px] font-medium leading-none">Médio</span>
                </button>

                <button
                  type="button"
                  data-preset="forte"
                  aria-pressed="false"
                  class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                  title="Sombra marcada com maior contraste"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <rect x="3" y="2.5" width="10.5" height="10.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <rect x="6.5" y="6" width="10.5" height="10.5" rx="2" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.2" />
                  </svg>
                  <span class="text-[10px] font-medium leading-none">Forte</span>
                </button>

                <button
                  type="button"
                  data-preset="flutuante"
                  aria-pressed="false"
                  class="py-2 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--color-brand)] aria-pressed:border-[var(--color-brand)] aria-pressed:text-white transition cursor-pointer flex flex-col items-center justify-center gap-1"
                  title="Elevação alta com sombra suave abaixo"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <rect x="4.5" y="2.5" width="11" height="9.5" rx="2" stroke="currentColor" stroke-width="1.5" />
                    <ellipse cx="10" cy="16.5" rx="5.5" ry="1.5" fill="currentColor" fill-opacity="0.35" />
                  </svg>
                  <span class="text-[10px] font-medium leading-none">Flutuar</span>
                </button>
              </div>
            </fieldset>

            <!-- Sliders de Sombra -->
            <div class="flex flex-col gap-2.5">
              <!-- Deslocamento X -->
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center justify-between">
                  <label
                    for="offsetX"
                    class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                  >
                    Deslocamento X (px)
                  </label>
                  <label for="numOffsetX" class="visually-hidden">Valor numérico de Deslocamento X</label>
                  <input
                    type="number"
                    id="numOffsetX"
                    name="numOffsetX"
                    min="-80"
                    max="80"
                    value="0"
                    class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                  />
                </div>
                <input
                  type="range"
                  id="offsetX"
                  name="offsetX"
                  min="-80"
                  max="80"
                  value="0"
                />
              </div>

              <!-- Deslocamento Y -->
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center justify-between">
                  <label
                    for="offsetY"
                    class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                  >
                    Deslocamento Y (px)
                  </label>
                  <label for="numOffsetY" class="visually-hidden">Valor numérico de Deslocamento Y</label>
                  <input
                    type="number"
                    id="numOffsetY"
                    name="numOffsetY"
                    min="-80"
                    max="80"
                    value="8"
                    class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                  />
                </div>
                <input
                  type="range"
                  id="offsetY"
                  name="offsetY"
                  min="-80"
                  max="80"
                  value="8"
                />
              </div>

              <!-- Desfoque (Blur) -->
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center justify-between">
                  <label
                    for="blur"
                    class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                  >
                    Desfoque / Blur (px)
                  </label>
                  <label for="numBlur" class="visually-hidden">Valor numérico de Desfoque</label>
                  <input
                    type="number"
                    id="numBlur"
                    name="numBlur"
                    min="0"
                    max="100"
                    value="26"
                    class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                  />
                </div>
                <input
                  type="range"
                  id="blur"
                  name="blur"
                  min="0"
                  max="100"
                  value="26"
                />
              </div>

              <!-- Opacidade -->
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center justify-between">
                  <label
                    for="opacity"
                    class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                  >
                    Opacidade
                  </label>
                  <label for="numOpacity" class="visually-hidden">Valor numérico de Opacidade</label>
                  <input
                    type="number"
                    id="numOpacity"
                    name="numOpacity"
                    min="0"
                    max="1"
                    step="0.05"
                    value="0.35"
                    class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                  />
                </div>
                <input
                  type="range"
                  id="opacity"
                  name="opacity"
                  min="0"
                  max="1"
                  step="0.05"
                  value="0.35"
                />
              </div>

              <!-- Margem Extra -->
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center justify-between">
                  <label
                    for="extraPadding"
                    class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                  >
                    Margem Extra (px)
                  </label>
                  <label for="numExtraPadding" class="visually-hidden">Valor numérico de Margem Extra</label>
                  <input
                    type="number"
                    id="numExtraPadding"
                    name="numExtraPadding"
                    min="0"
                    max="100"
                    value="12"
                    class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                  />
                </div>
                <input
                  type="range"
                  id="extraPadding"
                  name="extraPadding"
                  min="0"
                  max="100"
                  value="12"
                />
              </div>
            </div>
          </div>
        </details>

        <!-- Seção 2: Escala & Visualização -->
        <details open class="group">
          <summary
            class="px-4 py-3 flex items-center justify-between cursor-pointer select-none hover:bg-[var(--bg-subtle)]/70 transition"
          >
            <span class="flex items-center gap-2">
              <span
                class="w-6 h-6 rounded-md bg-[var(--brand-subtle)] text-[var(--color-brand)] flex items-center justify-center shrink-0"
                aria-hidden="true"
              >
                <!-- Lucide: scan-search -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
                  <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
                  <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
                  <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="m16 16-1.9-1.9"></path>
                </svg>
              </span>
              <span class="text-xs font-semibold text-[var(--text-main)]">Escala & Visualização</span>
            </span>
            <!-- Lucide: chevron-up -->
            <svg
              class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-200 rotate-180 group-open:rotate-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
          </summary>

          <div class="px-4 pb-4 pt-1 flex flex-col gap-3">
            <!-- Nível de Zoom -->
            <div class="flex items-center justify-between">
              <span
                class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
              >
                Nível de Zoom
              </span>
              <button
                type="button"
                id="btn-zoom-100"
                class="px-2.5 py-1 rounded-md text-[11px] font-mono font-medium bg-[var(--bg-subtle)] border border-[var(--border-color)] text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer"
                title="Clique para visualizar em 100% (1:1 pixels reais)"
              >
                100%
              </button>
            </div>

            <!-- Controles de Zoom Harmonizados -->
            <div
              id="zoom-toolbar"
              class="grid grid-cols-3 gap-1.5"
              role="group"
              aria-label="Controles de zoom e ajuste do palco"
            >
              <button
                type="button"
                id="btn-zoom-out"
                class="h-8 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer flex items-center justify-center"
                title="Diminuir Zoom (Roda do mouse para baixo)"
                aria-label="Diminuir Zoom"
              >
                <!-- Lucide: minus -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                </svg>
              </button>

              <button
                type="button"
                id="btn-zoom-in"
                class="h-8 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:border-[var(--border-strong)] transition cursor-pointer flex items-center justify-center"
                title="Aumentar Zoom (Roda do mouse para cima)"
                aria-label="Aumentar Zoom"
              >
                <!-- Lucide: plus -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                  <path d="M12 5v14"></path>
                </svg>
              </button>

              <button
                type="button"
                id="btn-zoom-fit"
                aria-pressed="true"
                class="h-8 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:border-[var(--border-strong)] aria-pressed:bg-[var(--brand-subtle)] aria-pressed:border-[var(--brand-border)] aria-pressed:text-[var(--color-brand)] transition cursor-pointer flex items-center justify-center gap-1.5 text-[11px] font-medium"
                title="Auto-ajustar ao palco (Duplo clique no palco)"
              >
                <!-- Lucide: maximize-2 -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <polyline points="9 21 3 21 3 15"></polyline>
                  <line x1="21" x2="14" y1="3" y2="10"></line>
                  <line x1="3" x2="10" y1="21" y2="14"></line>
                </svg>
                <span>Ajustar</span>
              </button>
            </div>

            <!-- Fundo do Palco -->
            <div class="flex flex-col gap-1.5">
              <span
                class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
              >
                Fundo do Preview
              </span>
              <div
                id="stage-theme-toolbar"
                class="grid grid-cols-3 gap-1 p-1 rounded-lg bg-[var(--bg-subtle)] border border-[var(--border-color)]"
                role="group"
                aria-label="Fundo de visualização do palco"
              >
                <button
                  type="button"
                  data-stage-theme="checkerboard"
                  aria-pressed="true"
                  class="py-1.5 px-2 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--bg-panel)] aria-pressed:text-[var(--color-brand)] aria-pressed:shadow-xs transition cursor-pointer flex items-center justify-center gap-1"
                >
                  <!-- Lucide: grid-2x2 -->
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                    <path d="M3 12h18"></path>
                    <path d="M12 3v18"></path>
                  </svg>
                  <span>Grade</span>
                </button>

                <button
                  type="button"
                  data-stage-theme="light"
                  aria-pressed="false"
                  class="py-1.5 px-2 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--bg-panel)] aria-pressed:text-[var(--color-brand)] aria-pressed:shadow-xs transition cursor-pointer flex items-center justify-center gap-1"
                >
                  <!-- Lucide: sun -->
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="m4.93 4.93 1.41 1.41"></path>
                    <path d="m17.66 17.66 1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="m6.34 17.66-1.41 1.41"></path>
                    <path d="m19.07 4.93-1.41 1.41"></path>
                  </svg>
                  <span>Claro</span>
                </button>

                <button
                  type="button"
                  data-stage-theme="dark"
                  aria-pressed="false"
                  class="py-1.5 px-2 rounded-md text-[11px] font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] aria-pressed:bg-[var(--bg-panel)] aria-pressed:text-[var(--color-brand)] aria-pressed:shadow-xs transition cursor-pointer flex items-center justify-center gap-1"
                >
                  <!-- Lucide: moon -->
                  <svg
                    class="w-3 h-3"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                  </svg>
                  <span>Escuro</span>
                </button>
              </div>
            </div>

            <!-- Quadro Técnico de Metadados -->
            <div
              class="p-2.5 rounded-lg bg-[var(--bg-subtle)] border border-[var(--border-color)] flex flex-col gap-1.5 text-[11px] font-mono"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-[var(--text-muted)] uppercase">Arquivo</span>
                <span
                  id="file-name-badge"
                  class="truncate max-w-[175px] text-[var(--text-main)] text-right"
                >
                  Nenhum
                </span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-[var(--text-muted)] uppercase">Dimensões</span>
                <span id="dimensions-badge" class="text-[var(--text-main)] text-right">—</span>
              </div>
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] text-[var(--text-muted)] uppercase">Saída Est.</span>
                <span
                  id="size-estimate-badge"
                  class="text-[var(--color-brand)] font-medium text-right"
                >
                  —
                </span>
              </div>
            </div>
          </div>
        </details>

        <!-- Seção 3: Formato & Compressão -->
        <details open class="group">
          <summary
            class="px-4 py-3 flex items-center justify-between cursor-pointer select-none hover:bg-[var(--bg-subtle)]/70 transition"
          >
            <span class="flex items-center gap-2">
              <span
                class="w-6 h-6 rounded-md bg-[var(--brand-subtle)] text-[var(--color-brand)] flex items-center justify-center shrink-0"
                aria-hidden="true"
              >
                <!-- Lucide: sliders-horizontal -->
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="21" x2="14" y1="4" y2="4"></line>
                  <line x1="10" x2="3" y1="4" y2="4"></line>
                  <line x1="21" x2="12" y1="12" y2="12"></line>
                  <line x1="8" x2="3" y1="12" y2="12"></line>
                  <line x1="21" x2="16" y1="20" y2="20"></line>
                  <line x1="12" x2="3" y1="20" y2="20"></line>
                  <line x1="14" x2="14" y1="2" y2="6"></line>
                  <line x1="8" x2="8" y1="10" y2="14"></line>
                  <line x1="16" x2="16" y1="18" y2="22"></line>
                </svg>
              </span>
              <span class="text-xs font-semibold text-[var(--text-main)]">Formato & Compressão</span>
            </span>
            <!-- Lucide: chevron-up -->
            <svg
              class="w-3.5 h-3.5 text-[var(--text-muted)] transition-transform duration-200 rotate-180 group-open:rotate-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
          </summary>

          <div class="px-4 pb-4 pt-1 flex flex-col gap-3">
            <fieldset class="border-0 p-0 m-0">
              <legend
                class="block text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)] mb-2"
              >
                Formato de Saída
              </legend>
              <div class="grid grid-cols-4 gap-1.5">
                <label
                  for="fmt-png"
                  class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
                >
                  <input
                    type="radio"
                    id="fmt-png"
                    name="export-format"
                    value="image/png"
                    checked
                    class="visually-hidden"
                  />
                  <span>PNG</span>
                </label>

                <label
                  for="fmt-webp"
                  class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
                >
                  <input
                    type="radio"
                    id="fmt-webp"
                    name="export-format"
                    value="image/webp"
                    class="visually-hidden"
                  />
                  <span>WebP</span>
                </label>

                <label
                  for="fmt-avif"
                  class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
                >
                  <input
                    type="radio"
                    id="fmt-avif"
                    name="export-format"
                    value="image/avif"
                    class="visually-hidden"
                  />
                  <span>AVIF</span>
                </label>

                <label
                  for="fmt-jpeg"
                  class="py-1.5 px-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] has-[:checked]:bg-[var(--brand-subtle)] has-[:checked]:border-[var(--color-brand)] has-[:checked]:text-[var(--color-brand)] text-center text-[11px] font-medium transition cursor-pointer select-none"
                >
                  <input
                    type="radio"
                    id="fmt-jpeg"
                    name="export-format"
                    value="image/jpeg"
                    class="visually-hidden"
                  />
                  <span>JPEG</span>
                </label>
              </div>
            </fieldset>

            <p id="format-hint" class="text-[11px] text-[var(--text-muted)] m-0 leading-relaxed">
              Sem perda de qualidade (Lossless) com fundo 100% transparente.
            </p>

            <!-- Controle de Qualidade -->
            <div
              id="quality-control-wrapper"
              class="flex flex-col gap-0.5 transition-opacity opacity-50 pointer-events-none"
            >
              <div class="flex items-center justify-between">
                <label
                  for="quality"
                  class="text-[10px] font-semibold uppercase tracking-wider text-[var(--text-muted)]"
                >
                  Qualidade (%)
                </label>
                <label for="numQuality" class="visually-hidden">Percentual de Qualidade</label>
                <input
                  type="number"
                  id="numQuality"
                  name="numQuality"
                  min="10"
                  max="100"
                  value="88"
                  class="w-14 px-1.5 py-0.5 rounded text-[11px] font-mono text-right bg-transparent hover:bg-[var(--bg-subtle)] focus:bg-[var(--bg-subtle)] text-[var(--text-main)] border border-transparent focus:border-[var(--border-strong)]"
                />
              </div>
              <input
                type="range"
                id="quality"
                name="quality"
                min="10"
                max="100"
                step="2"
                value="88"
              />
            </div>
          </div>
        </details>
      </form>

      <!-- Rodapé Fixo de Ações do Painel -->
      <footer
        class="p-3 border-t border-[var(--border-color)] bg-[var(--bg-panel)] flex items-center gap-2 shrink-0"
      >
        <button
          type="button"
          id="btn-copy"
          disabled
          class="px-3 py-2 rounded-lg text-xs font-medium border border-[var(--border-strong)] bg-[var(--bg-panel)] text-[var(--text-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-main)] disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center justify-center gap-1.5"
          title="Copiar imagem sombreada para a Área de Transferência (Ctrl+C)"
        >
          <!-- Lucide: copy -->
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span>Copiar</span>
        </button>

        <button
          type="button"
          id="btn-download"
          disabled
          class="flex-1 px-4 py-2 rounded-lg text-xs font-semibold bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white shadow-xs disabled:opacity-40 disabled:pointer-events-none transition cursor-pointer inline-flex items-center justify-center gap-1.5"
        >
          <!-- Lucide: check -->
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
          <span>
            <span id="download-action-label">Exportar</span>
            <span id="download-format-label">PNG</span>
          </span>
        </button>
      </footer>
    </aside>

    <!-- Área de Trabalho (Palco Amplo e Físico) -->
    <main class="flex-1 min-w-0 min-h-0 relative flex flex-col gap-2.5 overflow-hidden">
      <!-- Barra de Lote (exibida apenas quando há 2+ imagens carregadas) -->
      <div
        id="batch-queue-bar"
        class="hidden shrink-0 flex items-center gap-2 px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-panel)] shadow-[0_1px_2px_rgba(0,0,0,0.03)]"
        aria-label="Fila de imagens em lote"
      >
        <span
          id="batch-count-label"
          class="text-[11px] font-semibold text-[var(--text-muted)] shrink-0 pr-1"
        >
          Lote (0)
        </span>
        <div
          id="batch-queue-list"
          class="flex-1 min-w-0 flex items-center gap-1.5 overflow-x-auto py-0.5"
        ></div>
        <div class="flex items-center gap-1.5 shrink-0 pl-1.5 border-l border-[var(--border-color)]">
          <button
            type="button"
            id="btn-batch-add"
            class="px-2.5 py-1 rounded-lg text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand)] transition cursor-pointer"
            title="Adicionar mais imagens ao lote"
          >
            + Adicionar
          </button>
          <button
            type="button"
            id="btn-batch-clear"
            class="px-2.5 py-1 rounded-lg text-[11px] font-medium border border-[var(--border-color)] bg-[var(--bg-subtle)] text-[var(--text-muted)] hover:text-red-600 hover:border-red-500/40 transition cursor-pointer"
            title="Limpar todas as imagens"
          >
            Limpar
          </button>
        </div>
      </div>

      <!-- Wrapper do Palco -->
      <div
        id="stage-wrapper"
        class="stage-checkerboard relative flex-1 w-full min-w-0 min-h-[420px] lg:h-full rounded-xl border border-[var(--border-color)] shadow-[0_1px_2px_rgba(0,0,0,0.03)] overflow-hidden select-none transition-colors"
      >
        <!-- Estado Inicial Vazio -->
        <div id="empty-state" class="absolute inset-0 flex items-center justify-center p-6">
          <div
            class="max-w-sm w-full text-center p-7 rounded-xl bg-[var(--bg-panel)] border border-[var(--border-color)] shadow-[0_4px_16px_rgba(0,0,0,0.06)] flex flex-col items-center gap-3.5"
          >
            <div
              class="w-10 h-10 rounded-lg bg-[var(--brand-subtle)] text-[var(--color-brand)] flex items-center justify-center"
              aria-hidden="true"
            >
              <!-- Lucide: image -->
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                <circle cx="9" cy="9" r="2"></circle>
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
              </svg>
            </div>
            <div>
              <h1 class="text-sm font-semibold m-0 mb-1 text-[var(--text-main)]">
                Pronto para polir seus prints
              </h1>
              <p class="text-xs text-[var(--text-muted)] m-0 leading-relaxed">
                Cole com <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-subtle)] border border-[var(--border-color)] font-mono text-[11px] text-[var(--text-main)]">Ctrl + V</kbd> ou arraste uma ou várias imagens aqui.
              </p>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
              <label
                for="upload"
                class="px-3.5 py-1.5 rounded-lg text-xs font-medium bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white transition cursor-pointer"
              >
                Selecionar imagens
              </label>
              <button
                type="button"
                id="btn-sample"
                class="px-3.5 py-1.5 rounded-lg text-xs font-medium border border-[var(--border-strong)] bg-[var(--bg-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-main)] hover:bg-[var(--bg-muted)] transition cursor-pointer"
              >
                Print de Exemplo
              </button>
            </div>
          </div>
        </div>

        <!-- Container do Canvas -->
        <div
          id="canvas-container"
          class="hidden absolute inset-0 overflow-hidden cursor-grab active:cursor-grabbing touch-none"
        >
          <div
            id="canvas-transform"
            class="w-full h-full flex items-center justify-center pointer-events-none origin-center will-change-transform"
          >
            <canvas id="canvas" class="block shrink-0 max-w-none max-h-none rounded"></canvas>
          </div>
        </div>
      </div>

      <!-- Toast de Feedback Acessível -->
      <div
        id="status-toast"
        role="status"
        aria-live="polite"
        class="fixed bottom-5 right-5 z-50 px-3.5 py-2 rounded-lg bg-[#1c1c1a] text-white border border-white/10 text-xs font-medium shadow-lg transition-all duration-200 opacity-0 translate-y-2 pointer-events-none"
      ></div>
    </main>
  </div>

  <script>
    import { initImagePolisher } from '../scripts/polisher-client';
    document.getElementById('polisher-form')?.addEventListener('submit', (e) => e.preventDefault());
    initImagePolisher();
  </script>
</Layout>
